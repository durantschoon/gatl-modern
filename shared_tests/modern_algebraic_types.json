{
    "_license": "This file is provided under the Mozilla Public License 2.0. Copyright (c) 2024 Durant Schoon.",
    "test_suite": "modern_algebraic_types",
    "version": "1.0.0",
    "description": "Shared test data for modern algebraic types implementation",
    "license": "MPL-2.0",
    "copyright": "2024 Durant Schoon",
    "scalar_tests": {
        "basic_scalars": [
            {
                "name": "zero_scalar",
                "input": 0.0,
                "expected_grade": 0,
                "expected_is_zero": true,
                "expected_is_scalar": true
            },
            {
                "name": "positive_scalar",
                "input": 3.14,
                "expected_grade": 0,
                "expected_is_zero": false,
                "expected_is_scalar": true
            },
            {
                "name": "negative_scalar",
                "input": -2.718,
                "expected_grade": 0,
                "expected_is_zero": false,
                "expected_is_scalar": true
            }
        ]
    },
    "vector_tests": {
        "basic_vectors": [
            {
                "name": "empty_vector",
                "input": [],
                "expected_grade": 1,
                "expected_is_zero": true,
                "expected_is_vector": true,
                "expected_components": []
            },
            {
                "name": "single_component_vector",
                "input": [
                    [
                        1,
                        2.5
                    ]
                ],
                "expected_grade": 1,
                "expected_is_zero": false,
                "expected_is_vector": true,
                "expected_components": [
                    [
                        1,
                        2.5
                    ]
                ]
            },
            {
                "name": "multi_component_vector",
                "input": [
                    [
                        1,
                        1.0
                    ],
                    [
                        2,
                        2.0
                    ],
                    [
                        3,
                        3.0
                    ]
                ],
                "expected_grade": 1,
                "expected_is_zero": false,
                "expected_is_vector": true,
                "expected_components": [
                    [
                        1,
                        1.0
                    ],
                    [
                        2,
                        2.0
                    ],
                    [
                        3,
                        3.0
                    ]
                ]
            }
        ]
    },
    "bivector_tests": {
        "basic_bivectors": [
            {
                "name": "empty_bivector",
                "input": [],
                "expected_grade": 2,
                "expected_is_zero": true,
                "expected_is_bivector": true,
                "expected_components": []
            },
            {
                "name": "single_component_bivector",
                "input": [
                    [
                        1,
                        2,
                        1.5
                    ]
                ],
                "expected_grade": 2,
                "expected_is_zero": false,
                "expected_is_bivector": true,
                "expected_components": [
                    [
                        1,
                        2,
                        1.5
                    ]
                ]
            },
            {
                "name": "multi_component_bivector",
                "input": [
                    [
                        1,
                        2,
                        1.0
                    ],
                    [
                        2,
                        3,
                        2.0
                    ],
                    [
                        1,
                        3,
                        3.0
                    ]
                ],
                "expected_grade": 2,
                "expected_is_zero": false,
                "expected_is_bivector": true,
                "expected_components": [
                    [
                        1,
                        2,
                        1.0
                    ],
                    [
                        2,
                        3,
                        2.0
                    ],
                    [
                        1,
                        3,
                        3.0
                    ]
                ]
            }
        ]
    },
    "trivector_tests": {
        "basic_trivectors": [
            {
                "name": "empty_trivector",
                "input": [],
                "expected_grade": 3,
                "expected_is_zero": true,
                "expected_is_trivector": true,
                "expected_components": []
            },
            {
                "name": "single_component_trivector",
                "input": [
                    [
                        1,
                        2,
                        3,
                        2.5
                    ]
                ],
                "expected_grade": 3,
                "expected_is_zero": false,
                "expected_is_trivector": true,
                "expected_components": [
                    [
                        1,
                        2,
                        3,
                        2.5
                    ]
                ]
            }
        ]
    },
    "blade_term_tests": {
        "basic_blade_terms": [
            {
                "name": "scalar_blade",
                "basis": [],
                "coeff": 3.14,
                "expected_grade": 0,
                "expected_is_scalar": true,
                "expected_is_vector": false,
                "expected_is_bivector": false
            },
            {
                "name": "vector_blade",
                "basis": [
                    1
                ],
                "coeff": 2.5,
                "expected_grade": 1,
                "expected_is_scalar": false,
                "expected_is_vector": true,
                "expected_is_bivector": false
            },
            {
                "name": "bivector_blade",
                "basis": [
                    1,
                    2
                ],
                "coeff": 1.5,
                "expected_grade": 2,
                "expected_is_scalar": false,
                "expected_is_vector": false,
                "expected_is_bivector": true
            },
            {
                "name": "trivector_blade",
                "basis": [
                    1,
                    2,
                    3
                ],
                "coeff": 2.0,
                "expected_grade": 3,
                "expected_is_scalar": false,
                "expected_is_vector": false,
                "expected_is_bivector": false
            }
        ]
    },
    "multivector_tests": {
        "basic_multivectors": [
            {
                "name": "empty_multivector",
                "input": [],
                "expected_grade": 0,
                "expected_is_zero": true,
                "expected_is_multivector": true
            },
            {
                "name": "scalar_multivector",
                "input": [
                    {
                        "basis": [],
                        "coeff": 3.14
                    }
                ],
                "expected_grade": 0,
                "expected_is_zero": false,
                "expected_is_multivector": true
            },
            {
                "name": "mixed_grade_multivector",
                "input": [
                    {
                        "basis": [],
                        "coeff": 1.0
                    },
                    {
                        "basis": [
                            1
                        ],
                        "coeff": 2.0
                    },
                    {
                        "basis": [
                            1,
                            2
                        ],
                        "coeff": 3.0
                    }
                ],
                "expected_grade": 2,
                "expected_is_zero": false,
                "expected_is_multivector": true
            }
        ]
    },
    "grade_indexed_tests": {
        "grade_safety": [
            {
                "name": "grade_0_scalar",
                "grade": 0,
                "value": 3.14,
                "expected_grade": 0,
                "expected_has_grade_0": true,
                "expected_has_grade_1": false
            },
            {
                "name": "grade_1_vector",
                "grade": 1,
                "value": [
                    [
                        1,
                        1.0
                    ],
                    [
                        2,
                        2.0
                    ]
                ],
                "expected_grade": 1,
                "expected_has_grade_0": false,
                "expected_has_grade_1": true
            },
            {
                "name": "grade_2_bivector",
                "grade": 2,
                "value": [
                    [
                        1,
                        2,
                        1.0
                    ]
                ],
                "expected_grade": 2,
                "expected_has_grade_1": false,
                "expected_has_grade_2": true
            }
        ],
        "grade_compatibility": [
            {
                "name": "same_grade_compatible",
                "grade1": 1,
                "grade2": 1,
                "expected_compatible": true
            },
            {
                "name": "different_grade_incompatible",
                "grade1": 1,
                "grade2": 2,
                "expected_compatible": false
            }
        ]
    },
    "pattern_matching_tests": {
        "type_checks": [
            {
                "name": "scalar_type_check",
                "input": {
                    "type": "scalar",
                    "value": 3.14
                },
                "expected_is_scalar": true,
                "expected_is_vector": false,
                "expected_is_bivector": false,
                "expected_is_trivector": false,
                "expected_is_multivector": false
            },
            {
                "name": "vector_type_check",
                "input": {
                    "type": "vector",
                    "value": [
                        [
                            1,
                            1.0
                        ]
                    ]
                },
                "expected_is_scalar": false,
                "expected_is_vector": true,
                "expected_is_bivector": false,
                "expected_is_trivector": false,
                "expected_is_multivector": false
            },
            {
                "name": "bivector_type_check",
                "input": {
                    "type": "bivector",
                    "value": [
                        [
                            1,
                            2,
                            1.0
                        ]
                    ]
                },
                "expected_is_scalar": false,
                "expected_is_vector": false,
                "expected_is_bivector": true,
                "expected_is_trivector": false,
                "expected_is_multivector": false
            }
        ],
        "extraction_tests": [
            {
                "name": "extract_scalar",
                "input": {
                    "type": "scalar",
                    "value": 3.14
                },
                "extract_type": "scalar",
                "expected_success": true,
                "expected_value": 3.14
            },
            {
                "name": "extract_vector_wrong_type",
                "input": {
                    "type": "scalar",
                    "value": 3.14
                },
                "extract_type": "vector",
                "expected_success": false,
                "expected_value": null
            }
        ]
    },
    "cross_language_consistency": {
        "identical_results": [
            {
                "name": "scalar_creation",
                "cpp_input": "scalar(3.14)",
                "rust_input": "scalar(3.14)",
                "expected_result": 3.14
            },
            {
                "name": "vector_creation",
                "cpp_input": "vector({{1, 1.0}, {2, 2.0}})",
                "rust_input": "vector(vec![(1, 1.0), (2, 2.0)])",
                "expected_components": [
                    [
                        1,
                        1.0
                    ],
                    [
                        2,
                        2.0
                    ]
                ]
            },
            {
                "name": "bivector_creation",
                "cpp_input": "bivector({{1, 2, 1.0}})",
                "rust_input": "bivector(vec![(1, 2, 1.0)])",
                "expected_components": [
                    [
                        1,
                        2,
                        1.0
                    ]
                ]
            }
        ]
    },
    "performance_benchmarks": {
        "creation_speed": [
            {
                "name": "scalar_creation_benchmark",
                "iterations": 1000000,
                "operation": "create_scalar",
                "expected_max_time_ms": 100
            },
            {
                "name": "vector_creation_benchmark",
                "iterations": 100000,
                "operation": "create_vector",
                "expected_max_time_ms": 50
            },
            {
                "name": "bivector_creation_benchmark",
                "iterations": 100000,
                "operation": "create_bivector",
                "expected_max_time_ms": 50
            }
        ],
        "memory_usage": [
            {
                "name": "scalar_memory_usage",
                "operation": "create_scalar",
                "expected_max_bytes": 16
            },
            {
                "name": "vector_memory_usage",
                "operation": "create_vector",
                "expected_max_bytes": 64
            },
            {
                "name": "bivector_memory_usage",
                "operation": "create_bivector",
                "expected_max_bytes": 64
            }
        ]
    }
}